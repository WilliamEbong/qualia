{
  "name": "qualia-web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "api": "openapi-typescript ../openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@annotorious/react": "3.9.3",
    "@fontsource-variable/libre-franklin": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@recogito/react-text-annotator": "4.3.6",
    "@recogito/text-annotator": "4.3.6",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-table": "9.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.0.0"
  }
}
