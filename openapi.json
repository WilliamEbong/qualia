  "components": {
    "schemas": {
      "Availability": {
        "properties": {
          "allow_external": {
            "type": "boolean",
            "title": "Allow External"
          },
          "backends": {
            "items": {
              "$ref": "#/components/schemas/BackendAvailability"
            },
            "type": "array",
            "title": "Backends"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "allow_external",
          "backends"
        ],
        "title": "Availability"
      },
      "BackendAvailability": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "external": {
            "type": "boolean",
            "title": "External"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "available",
          "external",
          "reason"
        ],
        "title": "BackendAvailability"
      },
      "CaseInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "source_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Source Ids"
          },
          "attributes": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Attributes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CaseInput"
      },
      "ClassifyInput": {
        "properties": {
          "backend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Backend"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "segment_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segment Ids"
          },
          "task": {
            "type": "string",
            "enum": [
              "classification",
              "escalation"
            ],
            "title": "Task",
            "default": "classification"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ClassifyInput"
      },
      "ClassifyResult": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "backend": {
            "type": "string",
            "title": "Backend"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "segments": {
